{
  "name": "cornell-method",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build --webpack",
    "desktop:prepare-node-runtime": "node scripts/prepare-desktop-node-runtime.js",
    "desktop:sign-release": "node scripts/sign-macos-release.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:ts": "node --import tsx/esm --test \"test/**/*.test.ts\"",
    "test:desktop:lifecycle": "node --import tsx/esm --test test/desktop/desktop-lifecycle.test.ts",
    "test:desktop:node-runtime": "node --import tsx/esm --test test/desktop/desktop-node-runtime.test.ts",
    "test:codex-queue": "node --import tsx/esm --test \"test/codex-queue/*.test.ts\"",
    "test:e2e": "playwright test",
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:generate:postgres": "node scripts/prisma-run-postgres.js generate",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:postgres": "node scripts/prisma-run-postgres.js migrate deploy",
    "postgres:baseline:check": "node scripts/postgres-baseline-check.js",
    "postgres:import": "node scripts/postgres-import.js",
    "postgres:reconcile": "node scripts/postgres-reconcile.js",
    "postgres:export": "node scripts/postgres-export.js",
    "postgres:restore": "node scripts/postgres-restore.js",
    "postgres:retention:dry-run": "node scripts/postgres-retention.js --dry-run",
    "postgres:retention:prune": "node scripts/postgres-retention.js --apply --confirm-prune",
    "prisma:studio": "prisma studio",
    "backup:copy": "node scripts/backup-copy.js",
    "fixture:generate": "node scripts/generate-sqlite-fixture.js",
    "dev:fixture": "node scripts/dev-sqlite-fixture.js",
    "diagrams:extract": "node scripts/extract-mermaid-diagrams.js",
    "diagrams:svg": "node scripts/render-mermaid-diagrams.js",
    "diagrams:build": "npm run diagrams:extract && npm run diagrams:svg"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "prisma": "7.8.0",
    "@tauri-apps/api": "=2.5.0",
    "pg": "8.16.3",
    "@uiw/react-md-editor": "4.1.1",
    "better-sqlite3": "12.11.1",
    "date-fns": "^3.6.0",
    "dotenv": "17.4.2",
    "fabric": "7.4.0",
    "konva": "10.3.0",
    "next": "16.2.9",
    "react": "19.2.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.0",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.15.0",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "1.61.0",
    "puppeteer": "24.33.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@eslint/config-array": {
      "minimatch": "3.1.5"
    },
    "@eslint/eslintrc": {
      "ajv": "6.15.0",
      "js-yaml": "5.0.0",
      "minimatch": "3.1.5"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.13"
    },
    "@tailwindcss/postcss": {
      "postcss": "8.5.15"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    },
    "eslint": {
      "ajv": "6.15.0",
      "minimatch": "3.1.5"
    },
    "eslint-plugin-import": {
      "minimatch": "3.1.5"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "3.1.5"
    },
    "eslint-plugin-react": {
      "minimatch": "3.1.5"
    },
    "flat-cache": {
      "flatted": "3.4.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.15"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.1"
    },
    "next": {
      "postcss": "8.5.15"
    },
    "postcss": "8.5.15",
    "tinyglobby": {
      "picomatch": "4.0.4"
    }
  }
}
